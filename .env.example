# Supabase
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_ANON_KEY=...
SUPABASE_SERVICE_ROLE_KEY=...
NEXT_PUBLIC_SUPABASE_URL=https://<your-project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=...

# Backend BFF target. Browser code must not use this URL directly.
MUSIC_BACKEND_URL=http://localhost:8000

# Direct private Storage upload is the production byte path. Set false only as
# a temporary rollback to the bounded legacy multipart proxy.
NEXT_PUBLIC_DIRECT_ARTIFACT_UPLOAD=true

# Ask feature (optional OpenAI-compatible provider, configured server-side).
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=...
LLM_MODEL=<provider-model-id>

# Sentry (optional)
SENTRY_DSN=https://...
NEXT_PUBLIC_SENTRY_DSN=https://...

# OpenTelemetry / Grafana Cloud (optional)
# Standard OTLP values from Grafana Cloud > OpenTelemetry > Configure.
# Leave unset to disable export locally/CI without changing application behavior.
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-<zone>.grafana.net/otlp
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20...

# Feature flags
NEXT_PUBLIC_MOCK_ENABLED=true

# Canonical site URL used for OAuth redirects
NEXT_PUBLIC_SITE_URL=https://<your-app>.vercel.app
