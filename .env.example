# Local development environment contract only.
# Production values/defaults are deployment-owned and intentionally not mirrored here.

# Server-only backend / local tooling
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_ANON_KEY=...
SUPABASE_SERVICE_ROLE_KEY=...
MUSIC_BACKEND_URL=http://localhost:8000

# Backend observability (optional)
SENTRY_DSN_BACKEND=https://...
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-<zone>.grafana.net/otlp
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20...

# Ask / LLM provider (optional; OpenAI-compatible)
LLM_BASE_URL=https://<provider>/v1
LLM_API_KEY=...
LLM_MODEL=...
ASK_LLM_TIMEOUT_SECONDS=30
ASK_RATE_LIMIT=10/minute

# Browser-public values. Only NEXT_PUBLIC_* values may be referenced by client code.
NEXT_PUBLIC_SUPABASE_URL=https://<your-project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=...
NEXT_PUBLIC_SENTRY_DSN=https://...
NEXT_PUBLIC_MOCK_ENABLED=true
NEXT_PUBLIC_SITE_URL=http://localhost:3000
