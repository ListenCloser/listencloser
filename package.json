{
  "name": "listencloser",
  "version": "2.0.0",
  "private": true,
  "description": "Listen Closer \u2014 a music understanding workspace for synchronized representations, playback, and evidence-backed analysis.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "commit": "aicommits",
    "ci": "npm run build && npm run lint",
    "check": "bash scripts/check.sh",
    "check:full": "bash scripts/check.sh full",
    "check:fast": "bash scripts/check.sh fast",
    "check:frontend": "bash scripts/check.sh frontend",
    "check:backend": "bash scripts/check.sh backend",
    "check:e2e": "bash scripts/check.sh e2e",
    "test": "vitest run",
    "test:watch": "vitest",
    "api:schema": "uv run --project backend python backend/export_openapi.py",
    "api:generate": "npm run api:schema && openapi-typescript openapi/openapi.json -o lib/api-types.ts",
    "api:check": "npm run api:schema && git ls-files --error-unmatch openapi/openapi.json >/dev/null && git diff --exit-code -- openapi/openapi.json && openapi-typescript openapi/openapi.json -o lib/api-types.ts --check",
    "precommit": "pre-commit run --all-files"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@sentry/nextjs": "^10.66.0",
    "@supabase/supabase-js": "^2.45.0",
    "@tanstack/react-query": "5.101.4",
    "next": "16.3.3",
    "opensheetmusicdisplay": "^2.1.0",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@argos-ci/playwright": "^7.3.6",
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^6.0.3",
    "aicommits": "^3.4.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.19",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
