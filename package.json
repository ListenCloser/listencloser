{
  "name": "listencloser-monorepo",
  "version": "2.0.0",
  "private": true,
  "description": "Listen Closer monorepo: web workspace, Python services, and shared infrastructure.",
  "packageManager": "npm@10.9.9",
  "engines": {
    "node": "22.x"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "22.x",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "10.x",
      "onFail": "error"
    }
  },
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @listencloser/web",
    "build": "npm run build --workspace @listencloser/web",
    "start": "npm run start --workspace @listencloser/web",
    "lint": "npm run lint --workspace @listencloser/web",
    "lint:fix": "npm run lint:fix --workspace @listencloser/web",
    "typecheck": "npm run typecheck --workspace @listencloser/web",
    "test": "npm run test --workspace @listencloser/web",
    "test:watch": "npm run test:watch --workspace @listencloser/web",
    "api:schema": "npm run api:schema --workspace @listencloser/web",
    "api:generate": "npm run api:generate --workspace @listencloser/web",
    "api:check": "npm run api:check --workspace @listencloser/web",
    "doctor": "bash scripts/dev-doctor.sh",
    "bootstrap": "bash scripts/bootstrap.sh",
    "check": "bash scripts/check.sh",
    "check:full": "bash scripts/check.sh full",
    "check:fast": "bash scripts/check.sh fast",
    "check:preflight": "bash scripts/check.sh preflight",
    "check:frontend": "bash scripts/check.sh frontend",
    "check:backend": "bash scripts/check.sh backend",
    "check:database": "bash scripts/check-database.sh",
    "check:e2e": "bash scripts/check.sh e2e",
    "check:realstack": "bash scripts/check-real-stack.sh",
    "challenge": "bash scripts/challenge.sh",
    "precommit": "pre-commit run --all-files"
  }
}
