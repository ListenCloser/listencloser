{
  "name": "Music Lab Workspace V3",
  "version": 3,
  "description": "Design-token source of truth for the focused music-analysis workspace. Product chrome is warm charcoal; music evidence and playback use restrained semantic accents.",
  "color": {
    "bg": "#11110f",
    "bg-subtle": "#151512",
    "panel": "#191916",
    "panel-2": "#1e1e1a",
    "panel-3": "#26251f",
