    "accent": "#d6b56d",
    "accent-strong": "#e4c77f",
    "accent-2": "#86a6a1",
    "accent-soft": "rgba(214,181,109,0.12)",
    "danger": "#d57b72",
    "danger-soft": "rgba(213,123,114,0.11)",
    "success": "#8fb58a",
    "success-soft": "rgba(143,181,138,0.11)",
    "playback": "#8db2c7",
    "border": "rgba(241,239,232,0.075)",
    "border-strong": "rgba(241,239,232,0.14)",
    "paper": "#f4f1e8"
  },
  "semantic": {
    "harmony": "#8fb58a",
    "melody": "#c88d78",
    "rhythm": "#d0ad65",
