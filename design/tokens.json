    "6": "32px",
    "7": "48px",
    "8": "64px"
  },
  "typography": {
    "font-sans": "Geist, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    "font-display": "Iowan Old Style, Baskerville, 'Times New Roman', serif",
    "font-mono": "SFMono-Regular, Menlo, Consolas, monospace",
    "scale": {
      "xs": "11px",
      "sm": "12px",
      "base": "13px",
      "md": "14px",
      "lg": "17px",
      "xl": "22px",
      "2xl": "30px"
    },
    "weight": {
      "normal": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
