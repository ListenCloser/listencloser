{
  "schema_version": 1,
  "capabilities": {
    "key": {
      "status": "production",
      "input": "midi",
      "engine": "music21",
      "exposure": {"inspector": true, "annotations": false, "ask": true},
      "evaluation": {"dataset": "GuitarSet", "metric": "key_accuracy", "value": 0.8},
      "notes": "Global key only. Do not reinterpret this as a local key region."
    },
    "chord": {
      "status": "production",
      "input": "audio",
      "engine": "lv_chordia",
      "exposure": {"inspector": true, "annotations": true, "ask": true},
      "evaluation": {"dataset": "GuitarSet-comp", "metric": "root_accuracy", "value": 0.787},
      "notes": "Production chord evidence must come from the trusted lv-chordia path; monophonic/no-chord spans may be withheld."
    },
    "roman_numeral": {
      "status": "production",
      "input": "derived",
      "engine": "theory_interpreter",
      "requires": ["trusted_chord", "trusted_key"],
      "exposure": {"inspector": true, "annotations": true, "ask": true},
      "evaluation": {"dataset": "DCML-Mozart+BPS-FH", "metric": "oracle_full_match", "value": 0.998},
      "notes": "Oracle score is not end-to-end accuracy. Withhold when either trusted chord or trusted key evidence is absent."
    },
    "harmonic_function": {
      "status": "production",
      "input": "derived",
      "engine": "theory_interpreter",
      "requires": ["trusted_chord", "trusted_key"],
      "exposure": {"inspector": true, "annotations": true, "ask": true},
      "evaluation": {"dataset": "DCML-Mozart+BPS-FH", "metric": "oracle_function_accuracy", "value": 0.999},
      "notes": "Derived from Roman-numeral/key context; not an independent perception result."
    },
    "cadence": {
      "status": "withheld",
      "input": "derived",
      "engine": "theory_interpreter",
      "requires": ["trusted_chord", "trusted_key"],
      "exposure": {"inspector": false, "annotations": false, "ask": false},
      "evaluation": {"dataset": "DCML-Mozart", "metric": "f1", "value": 0.266},
      "reason": "Low held-out quality; prior adjacent-pattern detector over-matches and is not product-safe."
    },
    "key_region": {
      "status": "withheld",
      "input": "derived",
      "engine": "theory_interpreter",
      "requires": ["trusted_key"],
      "exposure": {"inspector": false, "annotations": false, "ask": false},
      "evaluation": {"dataset": "DCML", "metric": "boundary_accuracy", "value": 0.188},
      "reason": "Current implementation is a placeholder/global-key region, not validated local-key or modulation detection."
    },
    "tempo": {
      "status": "production",
      "input": "audio",
      "engine": "beat_engine",
      "exposure": {"inspector": true, "annotations": false, "ask": true}
    },
    "rhythm": {
      "status": "production",
      "input": "midi+beats",
      "engine": "analysis_v2",
      "exposure": {"inspector": true, "annotations": true, "ask": true},
      "notes": "Temporal density/rest features are deterministic measurements; richer musical interpretation remains incremental."
    },
    "melody": {
      "status": "experimental",
      "input": "midi",
      "engine": "lstom",
      "exposure": {"inspector": true, "annotations": false, "ask": true},
      "evaluation": {
        "dataset": "POP909",
        "metric": "f1",
        "value": 0.768,
        "details": "LStoM BiLSTM on 91-song held-out test set (seed=42). Precision=0.720, Recall=0.839. Cross-seed CV=0.3% across 3 seeds."
      },
      "model": {
        "name": "lstom_biLSTM_pop909",
        "version": "1.0.0",
        "architecture": "6-layer BiLSTM, 140 hidden units, 2.5M params",
        "training_dataset": "POP909 (MIT)",
        "training_split": "722/90/91 (seed=42)",
        "feature_schema": "pitch, duration, pitch_dist_below, pitch_dist_above, pos_in_bar, in_scale"
      },
      "validated_domain": "pop/arranged symbolic MIDI",
      "notes": "Validated on pop/arranged symbolic MIDI (POP909). Classical piano and general performance MIDI not formally validated. Model is deterministic, CPU-only (~390ms/song), 9.66MB."
    },
    "melody_register_peak": {
      "status": "experimental",
