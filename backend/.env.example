# Backend environment variables.
# In production scripts/deploy.sh writes backend/.env from GitHub Actions
# secrets/variables before Docker Compose replaces API + worker.

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role_jwt>
SUPABASE_ANON_KEY=<publishable_key>

# Sentry (optional)
SENTRY_DSN_BACKEND=https://...
SENTRY_ENV=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# Upload limits. Direct signed Storage upload is the normal browser byte path;
# this also bounds legacy/backend upload handling.
MAX_UPLOAD_BYTES=26214400

# Ask feature (optional OpenAI-compatible LLM provider).
# All three must be set for the /ask endpoint to respond; otherwise it returns 503
# and the rest of the application remains available.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=<provider_api_key>
LLM_MODEL=<provider_model_id>
ASK_LLM_TIMEOUT_SECONDS=30
ASK_RATE_LIMIT=10/minute

# OpenTelemetry export (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-<zone>.grafana.net/otlp
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20...

# Evaluation-only model flags (including historical All-In-One structure flags)
# do not belong in the production environment template. Follow the capability
# registry and evaluation documentation before enabling any research engine.
