# Local backend environment contract only.
# Production values/defaults are deployment-owned and may intentionally differ.

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role_jwt>

# Sentry (optional)
SENTRY_DSN_BACKEND=https://...
SENTRY_ENV=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Upload limits
MAX_UPLOAD_BYTES=26214400

# Ask feature (optional OpenAI-compatible LLM provider)
# All three must be set for the /ask endpoint to respond (otherwise 503).
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=<provider_api_key>
LLM_MODEL=~openai/gpt-latest
