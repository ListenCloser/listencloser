# Backend environment variables.
# docker-compose.yml hardcodes these values for VM persistence.

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role_jwt>

# Sentry (optional)
SENTRY_DSN_BACKEND=https://...
SENTRY_ENV=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# Upload limits
MAX_UPLOAD_BYTES=26214400

# Optional All-In-One audio structure worker. Enable only after its PyTorch,
# NATTEN and madmom runtime has been installed in the worker image.
ALLIN1_ENABLED=false
ALLIN1_MODEL=harmonix-all
ALLIN1_DEVICE=cpu

# Optional Tsumugi transcription challenger. Tsumugi runs in an isolated,
# separately provisioned runtime; it is not part of the backend dependency set.
# Pin that runtime to anime-song/tsumugi@9b48501ed05618fee0646c9e267bcb529e957898.
# A checkpoint is mandatory so the upstream first-run download is never implicit.
# TSUMUGI_PYTHON=/opt/tsumugi/.venv/bin/python
# TSUMUGI_CHECKPOINT=/models/tsumugi/default.ckpt
# TSUMUGI_CHECKPOINT_SHA256=<optional-pinned-sha256>
# TSUMUGI_DEVICE=cpu
# TSUMUGI_TIMEOUT_SECONDS=900

# Ask feature (OpenAI-compatible LLM provider)
# All three must be set for the /ask endpoint to respond (otherwise 503).
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=<provider_api_key>
LLM_MODEL=~openai/gpt-latest