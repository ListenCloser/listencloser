{
  "$defs": {
    "JobStage": {
      "enum": [
        "queued",
        "claimed",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "title": "JobStage",
      "type": "string"
    },
    "ProcessingStatus": {
      "properties": {
        "stage": {
          "$ref": "#/$defs/JobStage"
        },
        "progress": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Progress",
          "type": "number"
        },
        "message": {
          "default": "",
          "title": "Message",
          "type": "string"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "completed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completed At"
        }
      },
      "required": [
        "stage"
      ],
      "title": "ProcessingStatus",
      "type": "object"
    }
  },
  "properties": {
    "current": {
      "$ref": "#/$defs/JobStage",
      "default": "queued"
    },
    "progress": {
      "default": 0.0,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Progress",
      "type": "number"
    },
    "message": {
      "default": "",
      "title": "Message",
      "type": "string"
    },
    "stages": {
      "items": {
        "$ref": "#/$defs/ProcessingStatus"
      },
      "title": "Stages",
      "type": "array"
    },
    "retry_count": {
      "default": 0,
      "title": "Retry Count",
      "type": "integer"
    },
    "max_retries": {
      "default": 3,
      "title": "Max Retries",
      "type": "integer"
    },
    "lease_expires_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lease Expires At"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    }
  },
  "title": "JobLifecycle",
  "type": "object"
}