{
  "$defs": {
    "ArtifactKind": {
      "enum": [
        "audio_original",
        "audio_enhanced",
        "midi_performance",
        "midi_corrected",
        "musicxml_score",
        "rendered_score",
        "stems",
        "analysis_report"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "Capability": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        },
        "accepted_input_kinds": {
          "items": {
            "$ref": "#/$defs/ArtifactKind"
          },
          "title": "Accepted Input Kinds",
          "type": "array"
        },
        "produces_output_kinds": {
          "items": {
            "$ref": "#/$defs/ArtifactKind"
          },
          "title": "Produces Output Kinds",
          "type": "array"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "failure_modes": {
          "items": {
            "type": "string"
          },
          "title": "Failure Modes",
          "type": "array"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "Capability",
      "type": "object"
    },
    "JobLifecycle": {
      "properties": {
        "current": {
          "$ref": "#/$defs/JobStage",
          "default": "queued"
        },
        "progress": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Progress",
          "type": "number"
        },
        "message": {
          "default": "",
          "title": "Message",
          "type": "string"
        },
        "stages": {
          "items": {
            "$ref": "#/$defs/ProcessingStatus"
          },
          "title": "Stages",
          "type": "array"
        },
        "retry_count": {
          "default": 0,
          "title": "Retry Count",
          "type": "integer"
        },
        "max_retries": {
          "default": 3,
          "title": "Max Retries",
          "type": "integer"
        },
        "lease_expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lease Expires At"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "completed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completed At"
        }
      },
      "title": "JobLifecycle",
      "type": "object"
    },
    "JobStage": {
      "enum": [
        "queued",
        "claimed",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "title": "JobStage",
      "type": "string"
    },
    "ProcessingStatus": {
      "properties": {
        "stage": {
          "$ref": "#/$defs/JobStage"
        },
        "progress": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Progress",
          "type": "number"
        },
        "message": {
          "default": "",
          "title": "Message",
          "type": "string"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "completed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completed At"
        }
      },
      "required": [
        "stage"
      ],
      "title": "ProcessingStatus",
      "type": "object"
    }
  },
  "properties": {
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "workflow_id": {
      "format": "uuid",
      "title": "Workflow Id",
      "type": "string"
    },
    "capability": {
      "$ref": "#/$defs/Capability"
    },
    "lifecycle": {
      "$ref": "#/$defs/JobLifecycle"
    },
    "input_version_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Input Version Ids",
      "type": "array"
    },
    "output_version_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Output Version Ids",
      "type": "array"
    },
    "parameters": {
      "additionalProperties": true,
      "title": "Parameters",
      "type": "object"
    },
    "cache_key": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cache Key"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "error_details": {
      "additionalProperties": true,
      "title": "Error Details",
      "type": "object"
    },
    "provenance": {
      "additionalProperties": true,
      "title": "Provenance",
      "type": "object"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Created By"
    }
  },
  "required": [
    "workflow_id",
    "capability"
  ],
  "title": "Job",
  "type": "object"
}