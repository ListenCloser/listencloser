{
  "name": "oss_bakeoff_v1",
  "description": "OSS engine bakeoff corpus using existing real-world datasets with reference ground truth. Qualitative-only fixtures are in a separate manifest. Use `python -m evaluation.datasets.prepare --corpus real_audio_v1` or `real_world_v1` to resolve clips into MUSIC_EVAL_CACHE_DIR.",
  "datasets": {
    "real_audio_v1": {
      "source": "https://zenodo.org/records/3371780 (GuitarSet), https://zenodo.org/records/4603870 (BabySlakh)",
      "version": "v1",
      "license": "CC BY 4.0",
      "split": "test",
      "redistribution": "do not commit audio/annotations; download to cache"
    },
    "real_world_v1": {
      "source": "https://magenta.tensorflow.org/datasets/maestro, https://github.com/fosfrancesco/asap-dataset, https://github.com/marl/GuitarSet, https://zenodo.org/record/4599666",
